{
  "name": "quartz",
  "version": "0.5.0",
  "description": "Quartz — a free, open-source knowledge base for Markdown vaults",
  "license": "MIT",
  "homepage": "https://github.com/Quartz-Maker/Quartz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quartz-Maker/Quartz.git"
  },
  "author": "Quartz-Maker <353642199+Quartz-Maker@users.noreply.github.com>",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.quartz.app",
    "productName": "Quartz",
    "afterPack": "./scripts/afterPack.cjs",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "mimeType": "text/markdown"
      }
    ],
    "protocols": [
      {
        "name": "Quartz URL",
        "schemes": [
          "quartz"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "icon": "icon-512.png",
      "target": [
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "mimeTypes": [
        "inode/directory"
      ],
      "category": "Office",
      "maintainer": "Quartz-Maker <353642199+Quartz-Maker@users.noreply.github.com>"
    },
    "win": {
      "icon": "icon-512.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "icon": "icon-512.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.9.1",
    "@types/turndown": "^5.0.6",
    "electron": "43.7.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@electron/remote": "^2.1.3",
    "@fontsource/flow-circular": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@replit/codemirror-vim": "^6.4.0",
    "d3-force": "^3.0.0",
    "defuddle": "^0.19.4",
    "diff-match-patch": "1.0.5",
    "dompurify": "3.0.1",
    "hast-util-to-html": "7.1.3",
    "inter-ui": "4.1.1",
    "lucide": "1.14.0",
    "mdast-util-definitions": "4.0.0",
    "mdast-util-to-hast": "10.2.0",
    "mermaid": "11.13.0",
    "minisearch": "^7.2.0",
    "moment": "2.30.1",
    "pixi.js": "7.2.4",
    "prismjs": "1.30.0",
    "remark-parse": "8.0.3",
    "reveal.js": "^6.0.2",
    "turndown": "7.2.0",
    "unist-builder": "2.0.3",
    "unist-util-visit": "2.0.3",
    "vfile": "4.2.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.13"
  }
}
